    {
      "parameters": {
        "jsCode": "const website = $('Webhook').first().json.body.website;\nconst selectedReports = $('Webhook').first().json.body.reports || [];\n\nconst REPORT_CONFIGS = {\n  business: {\n    label: \"Business Analysis\",\n    outputFile: \"business_output.txt\",\n    prompt: `\nPerform a comprehensive Business Analysis.\n\nInclude:\n• Company overview\n• Business model\n• Products & Services\n• Unique Value Proposition\n• SWOT Analysis\n• Brand positioning\n• Market opportunities\n• Recommendations\n`\n  },\n\n  audience: {\n    label: \"Audience Research\",\n    outputFile: \"audience_output.txt\",\n    prompt: `\nPerform Audience Research.\n\nInclude:\n• Primary audience\n• Secondary audience\n• Demographics\n• Interests\n• Pain points\n• Customer personas\n• Buying behaviour\n• Marketing recommendations\n`\n  },\n\n  keyword: {\n    label: \"Keyword Research\",\n    outputFile: \"keyword_output.txt\",\n    prompt: `\nPerform Keyword Research.\n\nInclude:\n• Primary keywords\n• Secondary keywords\n• Long-tail keywords\n• Search intent\n• Keyword clusters\n• Content opportunities\n`\n  },\n\n  competitor: {\n    label: \"Competitor Discovery\",\n    outputFile: \"competitor_output.txt\",\n    prompt: `\nIdentify the company's competitors.\n\nInclude:\n• Direct competitors\n• Indirect competitors\n• Competitor strengths\n• Weaknesses\n• Market gaps\n• Differentiation opportunities\n`\n  },\n\n  backlink: {\n    label: \"Backlink Opportunities\",\n    outputFile: \"backlink_output.txt\",\n    prompt: `\nFind backlink opportunities.\n\nInclude:\n• High authority websites\n• Guest posting websites\n• Resource pages\n• Directories\n• Broken link opportunities\n• Partnership opportunities\n`\n  },\n\n  seo: {\n    label: \"SEO Analysis\",\n    outputFile: \"seo_output.txt\",\n    prompt: `\nPerform a complete SEO Audit.\n\nInclude:\n• Technical SEO\n• Meta titles\n• Meta descriptions\n• Heading hierarchy\n• Internal linking\n• Content quality\n• Keyword optimisation\n• Recommendations\n`\n  },\n\n  ad: {\n    label: \"Ad Creative Variants\",\n    outputFile: \"ad_output.txt\",\n    prompt: `\nGenerate Ad Creatives.\n\nInclude:\n• Google Ads\n• Facebook Ads\n• Instagram Ads\n• LinkedIn Ads\n• Headlines\n• Primary Text\n• CTA\n• Creative Ideas\n`\n  }\n};\n\nlet masterPrompt = `You are a Senior Digital Marketing Strategist.\n\nWebsite:\n${website}\n\nVisit this website yourself using your web browsing capability.\n\nAnalyze all publicly accessible pages of the website.\n\nDo NOT rely only on the homepage.\n\nGenerate ONLY the reports requested below.\n\n`;\n\nselectedReports.forEach(key => {\n\n    const report = REPORT_CONFIGS[key];\n    if (!report) return;\n\n    masterPrompt += `\n==========================================================\n${report.label.toUpperCase()}\n==========================================================\n\n${report.prompt}\n\nSave this report as:\n\n${report.outputFile}\n\n`;\n});\n\nmasterPrompt += `\n\nIMPORTANT\n\n• Visit the live website.\n• Do not invent information.\n• Base conclusions on publicly available website content.\n• Generate each report separately.\n• Save each report using its specified filename.\n• Output must be plain text (.txt).\n`;\n\nreturn [{\n    json: {\n        fileName: \"grok_prompt.txt\",\n        content: masterPrompt,\n        prompt: masterPrompt\n    }\n}];"
      },
