      "parameters": {
        "jsCode": "const items = $input.all();\nconst result = {};\n\n\nfor (const item of items) {\n  const src = item.json._src;\n  const text = item.json.data || \"\";\n  if (src === \"business\")     result.business = text;\n  if (src === \"audience\") result.audience = text;\n  if (src === \"keyword\")        result.keyword = text;\n  if (src === \"competitor\")     result.competitor = text;\n  if (src === \"backlink\")     result.backlink = text;\n  if (src === \"seo\")     result.seo = text;\n  if (src === \"ad\")     result.ad = text;\n  \n}\n\nreturn [{ json: { data: result } }];"
      },
